---
import "~/styles/components/SiteFooter.scss";
import config from "~/config.json";

const YEAR = new Date().getFullYear();
const ICON_LIST = [
    ["fa fa-brush fa-wag", "#b197fc"],
    ["fa fa-code fa-float", "#74c0fc"],
    ["fa fa-laptop-code fa-fade", "#241500"],
    ["fa fa-pen-clip fa-jello", "#f78aff"],
    ["fa fa-heart fa-beat-fade", "#ff6666"]
];
const PICKER = Math.floor(Math.random() * (ICON_LIST.length - 0) + 0); // 不包含最大值，包含最小值
var color_str = `--hover-color:${ICON_LIST[PICKER][1]}`;
---
<footer>
    <span class="footer-basic">Built in {YEAR}<i class={ICON_LIST[PICKER][0]} style={color_str}></i>{config.author}</span>
    {config.license_default &&
    <span class="footer-license">
        本站大部分文章在 {config.license_default} 下发布，具体参见文章底部许可说明
    </span>
    }
</footer>

<style lang="scss">
    @use "../styles/variables" as *;

    footer {
        .footer-basic {
            i[class*="fa"] {
                margin: 0 10px;
                animation-play-state: paused;
                animation-fill-mode: backwards;
            }
            &:hover i[class*="fa"] {
                color: var(--hover-color);
                animation-play-state: running;
            }
        }
    }
</style>